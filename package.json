{
	"name": "dsh-plugin-dashboard",
	"version": "0.1.0",
	"private": true,
	"description": "DSH third-party plugin version dashboard: a Web Settings tab listing installed plugins with current/latest versions (npm registry or git tags/HEAD) and one-click upgrade.",
	"type": "module",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./client": {
			"types": "./lib/client.d.ts",
			"default": "./lib/client.cjs"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml"
	],
	"dsh": {
		"bundle": {
			"patch": "cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-ui-slots"
			],
			"platform": "web"
		}
	},
	"license": "MIT",
	"author": "画野 (mtaech)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mtaech/dsh-plugin-dashboard.git"
	},
	"homepage": "https://github.com/mtaech/dsh-plugin-dashboard#readme",
	"bugs": {
		"url": "https://github.com/mtaech/dsh-plugin-dashboard/issues"
	},
	"keywords": [
		"dsh",
		"dsh-plugin",
		"dashboard",
		"plugin-manager",
		"upgrade"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "bun test",
		"smoke": "npm run build && node scripts/smoke.mjs"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
		"@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2",
		"@types/node": "^24.0.0",
		"@types/react": "~18.3.1",
		"@types/react-dom": "^18.3.5",
		"esbuild": "^0.25.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.8.0"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	}
}
