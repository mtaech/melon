{
	"name": "dsh-plugin-dashboard",
	"version": "0.1.3",
	"description": "DSH third-party plugin version dashboard: a Web Settings tab listing installed plugins with current/latest versions (npm registry or git tags/HEAD) and one-click upgrade.",
	"type": "module",
	"main": "lib/host.js",
	"types": "lib/host.d.ts",
	"exports": {
		".": {
			"types": "./lib/host.d.ts",
			"default": "./lib/host.js"
		},
		"./client": {
			"types": "./lib/client/main.d.ts",
			"default": "./lib/client.cjs"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml"
	],
	"dsh": {
		"bundle": {
			"patch": "cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-ui-slots"
			],
			"platform": "web"
		}
	},
	"license": "MIT",
	"author": "画野 (mtaech)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mtaech/melon.git",
		"directory": "packages/plugin-dashboard"
	},
	"homepage": "https://github.com/mtaech/melon/tree/main/packages/plugin-dashboard#readme",
	"bugs": {
		"url": "https://github.com/mtaech/melon/issues"
	},
	"keywords": [
		"dsh",
		"dsh-plugin",
		"dashboard",
		"plugin-manager",
		"upgrade"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "bun test",
		"smoke": "pnpm run build && node scripts/smoke.mjs",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@deepseek-ai/cordis": "catalog:",
		"@deepseek-ai/dsh-client-runtime": "catalog:",
		"@deepseek-ai/dsh-client-ui-settings": "catalog:",
		"@deepseek-ai/dsh-client-ui-slots": "catalog:",
		"@deepseek-ai/dsh-host-webserver": "catalog:",
		"@deepseek-ai/dsh-subprocess": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"esbuild": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:"
	}
}
