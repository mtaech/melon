{
	"name": "dsh-worksop-plus",
	"version": "0.1.8",
	"description": "DSH web plugin: enhanced workspace panel — pin, groups, hide, filter and bulk actions for the session sidebar",
	"type": "module",
	"license": "MIT",
	"author": "画野 (mtaech)",
	"main": "lib/host.js",
	"types": "lib/host.d.ts",
	"exports": {
		".": {
			"types": "./lib/host.d.ts",
			"default": "./lib/host.js"
		},
		"./client": "./lib/client.cjs",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"!lib/preview.html",
		"src",
		"cordis.patch.yml",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-renderer",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-workspace",
				"@deepseek-ai/dsh-api-session-controller",
				"@deepseek-ai/dsh-api-workspace-controller"
			],
			"platform": "web"
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"test": "bun test",
		"smoke": "pnpm run build && node scripts/smoke.mjs",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "catalog:",
		"@deepseek-ai/dsh-client-ui-settings": "catalog:",
		"@deepseek-ai/dsh-client-ui-slots": "catalog:",
		"@deepseek-ai/dsh-client-ui-workspace": "catalog:",
		"@deepseek-ai/dsh-settings": "catalog:",
		"@deepseek-ai/schemastery": "catalog:",
		"react": "catalog:",
		"@deepseek-ai/dsh-client-ui-primitives": "catalog:"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/cordis": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-settings": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-slots": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-workspace": {
			"optional": true
		},
		"@deepseek-ai/dsh-settings": {
			"optional": true
		},
		"@deepseek-ai/schemastery": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"@deepseek-ai/dsh-client-ui-primitives": {
			"optional": true
		}
	},
	"devDependencies": {
		"esbuild": "catalog:"
	}
}
