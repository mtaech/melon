{
	"name": "dsh-ast-edit-tool",
	"version": "0.1.0",
	"description": "DSH structural code-edit tool: preview and apply ast-grep rewrites ($NAME / $$$ARGS metavariables) over files, directories, and globs, ported from oh-my-pi's ast_edit.",
	"type": "module",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml"
	],
	"dsh": {
		"bundle": {
			"patch": "cordis.patch.yml"
		}
	},
	"license": "MIT",
	"author": "画野 (mtaech)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mtaech/melon.git",
		"directory": "packages/ast-edit-tool"
	},
	"homepage": "https://github.com/mtaech/melon/tree/main/packages/ast-edit-tool#readme",
	"bugs": {
		"url": "https://github.com/mtaech/melon/issues"
	},
	"keywords": [
		"dsh",
		"dsh-plugin",
		"cordis",
		"ast-grep",
		"codemod",
		"structural-edit"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "bun test",
		"smoke": "pnpm run build && node scripts/smoke.mjs",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@ast-grep/cli": "^0.45.2",
		"fast-glob": "^3.3.3",
		"ignore": "^7.0.3"
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
		"@deepseek-ai/schemastery": "^3.18.1"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-tools": {
			"optional": true
		},
		"@deepseek-ai/schemastery": {
			"optional": true
		}
	},
	"devDependencies": {
		"@deepseek-ai/dsh-tools": "catalog:",
		"@deepseek-ai/schemastery": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
